@using BTCPayServer.Client
@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Plugins.USDC
@using BTCPayServer.Views.Server
@using BTCPayServer.Plugins.USDC.Configuration
@inject USDCPluginConfiguration Configuration
@foreach (var config in Configuration.EVMUSDCLikeConfigurationItems.Values)
{
    <li permission="@Policies.CanModifyServerSettings">
        <a class="dropdown-item @ViewData.ActivePageClass(USDCPlugin.PluginNavKey, typeof(ServerNavPages).ToString(), $"EVM-{config.GetPaymentMethodId()}")" asp-controller="UIEVMUSDCLikeServer" asp-action="GetServerConfig"
           asp-route-paymentMethodId="@config.GetPaymentMethodId()">USDC on @config.Chain</a>
    </li>
}
